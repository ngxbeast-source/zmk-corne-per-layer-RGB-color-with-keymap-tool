/* EXPERIMENTAL: Momentary + Blink helper (use with RGB_HT) */
#define MO_BLINK(node_name, node_label, layer, blink_color, return_color, wait) \
        ZMK_MACRO(node_name, \
            label = node_label; \
            bindings = <&macro_press &mo layer BLINK_SEQ(blink_color, return_color, wait)>, \
                       <&macro_pause_for_release>, \
                       <&macro_release &mo layer>; \
        )
/* EXPERIMENTAL: Blink helper - Hardcode a &kp you want to "blink", used in conjunction with tap-dance*/
// USED FOR NUM/CAPSLOCK BLINK BEHAVIOR, COLORS NEED TO HARDCODED TO THE &kp in A macro then we can move it to the tap-dance
#define KP_BLINK(node_name, node_label, key, blink_color, return_color, wait) \
         ZMK_MACRO(node_name, \
            label = node_label; \
            bindings = <&macro_tap &kp key>; \ 
            <BLINK_SEQ(blink_color, return_color, wait)>; \
        )

/* USE THE HELPERS FOR REFERENCE TO BUILD YOUR MACROS AND/OR BEHAVIORS. NOTHING HAS TO BE CHANGED HERE */
// #define MOMENTARY_RGB_MACRO(node_name, node_label, layer, active_color, release_color)
/* ---- MACRO HELPERS ---- */
#define MOMENTARY_RGB_MACRO(node_name, node_label, layer, active_color, release_color) \
        ZMK_MACRO(node_name, \
            bindings = \
                <&macro_press>, \
                <&mo layer>, \
                <&macro_tap>, \
                <&rgb_ug active_color>, \
                <&macro_pause_for_release>, \
                <&macro_release>, \
                <&mo layer>, \
                <&macro_tap>, \
                <&rgb_ug release_color>; \
            label = node_label; \
        )

#define TO_RGB_MACRO(node_name, node_label, layer, color) \
        ZMK_MACRO(node_name, \
            bindings = \
                <&macro_tap>, \
                <&to layer>, \
                <&macro_tap>, \
                <&rgb_ug color>; \
            label = node_label; \
        )

#define TO_RGB_PRESS_MACRO(node_name, node_label, layer, color) \
        ZMK_MACRO(node_name, \
            bindings = \
                <&macro_tap>, \
                <&to layer>, \
                <&macro_press>, \
                <&rgb_ug color>; \
            label = node_label; \
        )

/* ---- HOLD-TAP BEHAVIOR HELPER---- */
#define RGB_HOLD_TAP(node_name, node_label, macro_ref) \
        node_name: node_name { \
            compatible = "zmk,behavior-hold-tap"; \
            label = node_label; \
            bindings = <&macro_ref>, <&kp>; \
            #binding-cells = <2>; \
            tapping-term-ms = <200>; \
            flavor = "tap-preferred"; \
        };

/* ---- COMBO HELPER ---- */
#define CMB(name, bind, p1, p2, ...) \
    name { bindings = <bind>; key-positions = <p1 p2>; layers = <__VA_ARGS__>; timeout-ms = <50>; }





