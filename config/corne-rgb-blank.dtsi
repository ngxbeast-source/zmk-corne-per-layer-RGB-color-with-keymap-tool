/* ---- MACRO HELPERS (Templates for building new macros) ---- */
#define MOMENTARY_RGB_MACRO(node_name, node_label, layer, active_color, release_color) \
        ZMK_MACRO(node_name, \
            bindings = \
                <&macro_press>, \
                <&mo layer>, \
                <&macro_tap>, \
                <&rgb_ug active_color>, \
                <&macro_pause_for_release>, \
                <&macro_release>, \
                <&mo layer>, \
                <&macro_tap>, \
                <&rgb_ug release_color>; \
            label = node_label; \
        )

#define TO_RGB_MACRO(node_name, node_label, layer, color) \
        ZMK_MACRO(node_name, \
            bindings = \
                <&macro_tap>, \
                <&to layer>, \
                <&macro_tap>, \
                <&rgb_ug color>; \
            label = node_label; \
        )

#define TO_RGB_PRESS_MACRO(node_name, node_label, layer, color) \
        ZMK_MACRO(node_name, \
            bindings = \
                <&macro_tap>, \
                <&to layer>, \
                <&macro_press>, \
                <&rgb_ug color>; \
            label = node_label; \
        )

/* ---- HOLD-TAP BEHAVIOR TEMPLATE ---- */
#define RGB_HOLD_TAP(node_name, node_label, macro_ref) \
        node_name: node_name { \
            compatible = "zmk,behavior-hold-tap"; \
            label = node_label; \
            bindings = <&macro_ref>, <&kp>; \
            #binding-cells = <2>; \
            tapping-term-ms = <200>; \
            flavor = "tap-preferred"; \
        };

/* ---- (OPTIONAL) COMBO HELPER ---- */
#define COMBO(name, bind, p1, p2, ...) \
    name { bindings = <bind>; key-positions = <p1 p2>; layers = <__VA_ARGS__>; timeout-ms = <50>; }

/ {
    /* ---- STEP 2+3: MACROS (define your macros for each layer/behavior) ---- */
    macros {
        // Example:
        // TO_RGB_MACRO(base_led, "Base Layer LED", LAYER_BASE, RGB_BASE)
        // MOMENTARY_RGB_MACRO(fn_led, "FN Layer Momentary LED", LAYER_FN, RGB_FN, RGB_BASE)
    };

    /* ---- (OPTIONAL) BLINK/STATUS MACROS ---- */
    // Define blink/caps/num macros here if needed

    /* ---- STEP 4: BEHAVIORS - HOLD-TAP ---- */
    behaviors {
        // Example:
        // RGB_HOLD_TAP(hold_tap_fn, "HOLD_TAP_FN", fn_led)
    };

    /* ---- (OPTIONAL) STEP 5: COMBOS ---- */
    combos {
        compatible = "zmk,combos";
        // Example:
        // COMBO(my_combo, &kp ESC, 0, 1, LAYER_BASE)
    };

    /* ---- (OPTIONAL) Tap dance ---- */
    // Define tap dance behaviors here if needed
};