#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            global-quick-tap;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <600>;
            global-quick-tap;
            quick-tap-ms = <400>;
        };

        soft_off: soft_off {
            compatible = "zmk,behavior-soft-off";
            label = "SOFT_OFF";
            #binding-cells = <0>;
            hold-time-ms = <1500>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_bkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 3>;
            timeout-ms = <50>;
        };

        right_bkt {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
            timeout-ms = <50>;
        };

        left_par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <15 16>;
            timeout-ms = <50>;
        };

        right_par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 20>;
            timeout-ms = <50>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <27 28>;
            timeout-ms = <50>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <32 31>;
            timeout-ms = <50>;
        };

        bac {
            bindings = <&kp BACKSLASH>;
            key-positions = <5 6>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <17 18>;
        };
    };

    macros {
        to_game: to_game {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog 4 &rgb_ug RGB_COLOR_HSB(35,100,50)>;
            label = "TO_GAME";
        };

        tgl_led: tgl_led {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo 6 &rgb_ug RGB_COLOR_HSB(116,100,35)>,
                <&macro_tap>,
                <&kp LEFT>;

            label = "TGL_LED";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        abc {
        display-name = "ABC";
            bindings = <
&kp ESC         &kp Q  &kp W           &kp E        &kp R             &kp T          &kp Y      &kp U         &kp I          &kp O            &kp P               &kp BSPC
&kp LEFT_SHIFT  &kp A  &hm LEFT_ALT S  &hm LCTRL D  &hm LEFT_SHIFT F  &kp G          &kp H      &hm RSHIFT J  &hm RCTRL K    &hm RIGHT_ALT L  &hm RGUI SEMICOLON  &kp SQT
&kp LCTRL       &kp Z  &kp X           &kp C        &kp V             &kp B          &kp N      &kp M         &kp COMMA      &kp DOT          &kp FSLH            &kp ESC
                                       &kp TAB      &lt 1 SPACE       &lt 2 ENTER    &lt 3 DEL  &tgl_led      &hm F11 RIGHT
            >;
        };

        nmrw {
        display-name = "NMRW";
            bindings = <
&kp ESC  &kp N1  &kp N2         &kp N3    &kp N4       &kp N5    &kp N6     &kp N7        &kp N8         &kp N9         &kp N0    &kp BSPC
&trans   &trans  &kp PAGE_DOWN  &kp UP    &kp PAGE_UP  &kp F5    &kp MINUS  &kp EQUAL     &trans         &trans         &kp SQT   &kp GRAVE
&trans   &trans  &kp LEFT       &kp DOWN  &kp RIGHT    &trans    &kp LBKT   &kp RBKT      &kp LS(PG_UP)  &kp LS(PG_DN)  &kp BSLH  &kp DEL
                                &trans    &trans       &trans    &trans     &kp LC(LEFT)  &kp LC(RIGHT)
            >;
        };

        k_pd {
        display-name = "KPAD";
            bindings = <
&kp ESCAPE  &trans  &trans        &trans    &trans         &trans           &kp KP_N7       &kp KP_N8  &kp KP_N9  &trans    &trans    &kp BSPC
&kp CAPS    &trans  &kp HOME      &kp UP    &kp END        &kp PG_UP        &kp KP_N4       &kp KP_N5  &kp KP_N6  &trans    &kp UP    &trans
&trans      &trans  &kp LC(LEFT)  &kp DOWN  &kp LC(RIGHT)  &kp PAGE_DOWN    &kp KP_N1       &kp KP_N2  &kp KP_N3  &kp LEFT  &kp DOWN  &kp RIGHT
                                  &trans    &trans         &trans           &kp KP_NUMLOCK  &trans     &kp KP_N0
            >;
        };

        xtra {
        display-name = "XTRA";
            bindings = <
&bt BT_CLR          &bt BT_SEL 0     &bt BT_SEL 1      &bt BT_SEL 2  &bt BT_SEL 3    &trans            &rgb_ug RGB_EFF  &trans           &hm C_PLAY_PAUSE C_REWIND  &kp C_FAST_FORWARD  &trans    &rgb_ug RGB_TOG
&out OUT_TOG        &trans           &kp LS(LA(DOWN))  &kp UP        &kp LS(LA(UP))  &trans            &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &hm K_MUTE C_VOL_DN        &kp C_VOLUME_UP     &kp UP    &trans
&kp LA(LC(ESCAPE))  &kp LA(LC(DEL))  &kp LEFT          &kp DOWN      &kp RIGHT       &trans            &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &trans                     &kp LEFT            &kp DOWN  &kp RIGHT
                                                       &trans        &trans          &studio_unlock    &trans           &rgb_ug RGB_BRD  &rgb_ug RGB_BRI
            >;
        };

        game {
        display-name = "GAME";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E         &kp R      &kp T          &kp Y    &kp U  &kp I          &kp O          &kp P     &kp BSPC
&kp LSHFT  &kp A  &kp S  &kp D         &kp F      &kp G          &kp H    &kp J  &kp K          &kp L          &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C         &kp V      &kp B          &kp N    &kp M  &kp LS(PG_DN)  &kp LS(PG_UP)  &kp FSLH  &kp ESC
                         &kp LEFT_ALT  &kp SPACE  &lt 5 ENTER    &kp DEL  &mo 6  &trans
            >;
        };

        gfun {
        display-name = "GFUN";
            bindings = <
&kp ESCAPE  &kp N1  &kp W   &kp N2  &kp N3  &none    &kp KP_N7   &kp KP_N8  &kp KP_N9     &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp KP_MINUS
&none       &kp A   &kp S   &kp D   &kp N4  &none    &kp KP_N4   &kp KP_N5  &kp KP_N6     &none          &none            &kp KP_PLUS
&none       &kp F1  &kp F2  &kp F3  &kp F4  &none    &kp KP_N1   &kp KP_N2  &none         &none          &none            &kp PAGE_UP
                            &none   &none   &none    &kp KP_DOT  &kp KP_N3  &kp KP_ENTER
            >;
        };

        togl {
        display-name = "TOGL";
            bindings = <
&to_game  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none     &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none     &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
                        &none  &none  &none    &none  &none  &none
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };

        extra4 { status = "reserved"; };
    };
};
