#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include "corne-rgb.dtsi"

/ {
    keymap {
        compatible = "zmk,keymap";

        abc {
            display-name = "ABC";
            bindings = <
&kp ESC      &kp Q  &kp W           &kp E        &kp R                       &kp T                         &kp Y                     &kp U                       &kp I          &kp O            &kp P               &kp BSPC
&kp LEFT_SHIFT  &kp A  &hm LEFT_ALT S  &hm LCTRL D  &hm LEFT_SHIFT F            &kp G                         &kp H                     &hm RSHIFT J                &hm RCTRL K    &hm RIGHT_ALT L  &hm RGUI SEMICOLON  &kp SQT
&kp LCTRL       &kp Z  &kp X           &kp C        &kp V                       &kp B                         &kp N                     &kp M                       &kp COMMA      &kp DOT          &kp FSLH            &kp ESC
                                       &kp TAB      &hold_tap_nmrw 0 SPACE  &hold_tap_kpad 0 ENTER    &hold_tap_xtra 0 DEL  &hold_tap_xtra2 0 LEFT  &hm F11 RIGHT
            >;
        };

        nmrw {
            display-name = "NMRW";
            bindings = <
&kp ESC  &kp N1  &kp N2         &kp N3       &kp N4       &kp N5    &kp N6     &kp N7        &kp N8         &kp N9         &kp N0    &kp BSPC
&trans   &trans  &kp PAGE_DOWN  &kp UP       &kp PAGE_UP  &trans    &kp MINUS  &kp EQUAL     &trans         &trans         &kp SQT   &kp GRAVE
&trans   &trans  &kp LEFT       &kp DOWN     &kp RIGHT    &trans    &kp LBKT   &kp RBKT      &kp RS(PG_UP)  &kp RS(PG_DN)  &kp BSLH  &kp DEL
                                &bootloader  &trans       &trans    &trans     &kp LC(LEFT)  &kp LC(RIGHT)
            >;
        };

        k_pd {
            display-name = "KPAD";
            bindings = <
&kp ESCAPE         &trans     &trans            &trans      &trans             &kp F5           &kp KP_N7       &kp KP_N8  &kp KP_N9  &trans    &trans    &kp BSPC
&kp CAPS           &trans     &kp HOME          &kp UP      &kp END            &kp BACKSPACE    &kp KP_N4       &kp KP_N5  &kp KP_N6  &trans    &kp UP    &trans
&hm (LC(X)) LC(C)  &kp LC(V)  &kp LC(LS(LEFT))  &kp DOWN    &kp LC(LS(RIGHT))  &kp RET          &kp KP_N1       &kp KP_N2  &kp KP_N3  &kp LEFT  &kp DOWN  &kp RIGHT
                                                &kp LA(F4)  &trans             &trans           &kp KP_NUMLOCK  &trans     &kp KP_N0
            >;
        };

        xtra {
            display-name = "XTRA";
            bindings = <
&bt BT_CLR          &bt BT_SEL 0     &bt BT_SEL 1      &bt BT_SEL 2  &bt BT_SEL 3    &trans            &rgb_ug RGB_EFF  &trans           &hm C_PLAY_PAUSE C_REWIND  &kp C_FAST_FORWARD  &trans    &rgb_ug RGB_TOG
&out OUT_TOG        &trans           &kp LS(LA(DOWN))  &kp UP        &kp LS(LA(UP))  &trans            &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &hm C_MUTE C_VOL_DN        &kp C_VOLUME_UP     &kp UP    &kp ENTER
&kp LA(LC(ESCAPE))  &kp LA(LC(DEL))  &kp LEFT          &kp DOWN      &kp RIGHT       &trans            &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &trans                     &kp LEFT            &kp DOWN  &kp RIGHT
                                                       &kp LA(END)   &trans          &studio_unlock    &trans           &rgb_ug RGB_BRD  &rgb_ug RGB_BRI
            >;
        };
        xtr2 {
            display-name = "XTR2";
            bindings = <
&none  &none  &none  &none  &none  &none    &none  &none  &none        &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none        &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none        &none  &none  &none
                     &none  &none  &none    &none  &none  &bootloader
            >;

            label = "xtr2";
        };

        game {
            display-name = "GAME";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E         &kp R      &kp T                         &kp Y  &kp U  &kp I            &kp O              &kp P     &kp BSPC
&kp LSHFT  &kp A  &kp S  &kp D         &kp F      &kp G                         &kp H  &kp J  &kp K            &kp L              &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C         &kp V      &kp B                         &kp N  &kp M  &kp RS(PAGE_UP)  &kp RS(PAGE_DOWN)  &kp FSLH  &kp ESC
                         &kp LEFT_ALT  &kp SPACE  &hold_tap_gfun 0 ENTER    &hold_tap_gtgl 0 LEFT  &none  &none
            >;
        };

        gfun {
            display-name = "GFUN";
            bindings = <
&kp ESCAPE     &kp N1  &kp W   &kp N2      &kp N3  &none    &kp KP_N7   &kp KP_N8  &kp KP_N9     &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp KP_MINUS
&kp LS(GRAVE)  &kp A   &kp S   &kp D       &kp N4  &none    &kp KP_N4   &kp KP_N5  &kp KP_N6     &none          &none            &kp KP_PLUS
&none          &kp F1  &kp F2  &kp F3      &kp F4  &none    &kp KP_N1   &kp KP_N2  &none         &none          &out OUT_TOG     &kp PAGE_UP
                               &kp LA(F4)  &none   &none    &kp KP_DOT  &kp KP_N3  &kp KP_ENTER
            >;
        };

        game_toggle {
            display-name = "GTGL";
            bindings = <
&g2_led  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
                     &none  &none  &none    &none  &none  &none
            >;

            label = "GTGL";
        };

        game2 {
            display-name = "GME2";
            bindings = <
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
                     &none  &none  &none    &none  &none  &none
            >;

            label = "GAME2";
        };


        Toggle_Layers {
            bindings = <
&t1_led  &to_t2_led  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none    &none       &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none    &none       &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
                            &none  &none  &none    &none  &none  &none
            >;

            label = "TOG";
        };

        toggle_1 {
            bindings = <
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
                     &none  &none  &none    &none  &none  &none
            >;

            label = "T1";
        };

        toggle_2 {
            bindings = <
&none  &none  &none  &none  &none  &none                      &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                      &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                      &none  &none  &none  &none  &none  &none
                     &none  &none  &hold_tap_t2_s1 0 SPACE    &none  &none  &none
            >;

            label = "T2";
        };

        toggle2_sublayer1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "T2.1";
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };

        extra4 { status = "reserved"; };
    };
};
