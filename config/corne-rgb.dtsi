/* ---- STEP 1: DEFINE LAYERS ---- */

// Macro-based layer/color definition for compactness and maintainability
#define LAYERS(_) \
    _(ABC,      0, RGB_COLOR_HSB(19,100,17))\
    _(NMRW,     1, RGB_COLOR_HSB(183,45,18))\
    _(KPAD,     2, RGB_COLOR_HSB(230,87,26))\
    _(XTRA,     3, RGB_COLOR_HSB(273,67,23))\
    _(XTR2,     4, RGB_COLOR_HSB(116,67,26))\
    _(GAME,     5, RGB_COLOR_HSB(0,100,25))\
    _(GFUN,     6, RGB_COLOR_HSB(116,67,50))\
    _(GAMETGL,  7, RGB_COLOR_HSB(200,100,60))\
    _(GAME2,    8, RGB_COLOR_HSB(73,67,15))\
    _(GAME2_SUBLR1, 9, RGB_COLOR_HSB(67,55,50))\
    _(TGL,     10, RGB_COLOR_HSB(251,67,50))\
    _(TGLLR_1, 11, RGB_COLOR_HSB(40,100,12))\
    _(TGLLR_1_SUBLR_1, 12, RGB_COLOR_HSB(58,45,50))\
    _(TGLLR_2, 13, RGB_COLOR_HSB(85,100,15))\
    _(TGLLR_2_SUBLR_1, 14, RGB_COLOR_HSB(82,100,50))

#define LAYER_DEF(name, idx, col)   #define LAYER_##name idx
#define COLOR_DEF(name, idx, col)   #define RGB_##name col
LAYERS(LAYER_DEF)
LAYERS(COLOR_DEF)

/* ---- (OPTIONAL) BLINK HELPERS ---- */
#define BLINK_ON     RGB_COLOR_HSB(39,100,75)    /* Blink On - Bright Yellow */
#define BLINK_OFF    RGB_COLOR_HSB(273,67,23)    /* Blink Off - Light Purple */
#define N_BLINK_ON   RGB_COLOR_HSB(0,100,60)     /* Num On - Bright Red */
#define N_BLINK_OFF  RGB_COLOR_HSB(19,100,17)    /* Num Off - Yellow */
#define C_BLINK_ON   RGB_COLOR_HSB(200,100,60)   /* Caps On - Cyan */
#define C_BLINK_OFF  RGB_COLOR_HSB(19,100,17)    /* Caps Off - Yellow */
#define BLINK_SEQ(ON, OFF, WAIT) \
    &macro_tap &rgb_ug ON \
    &macro_wait_time WAIT \
    &macro_tap &rgb_ug RGB_TOG \
    &macro_wait_time WAIT \
    &macro_tap &rgb_ug RGB_TOG \
    &macro_wait_time WAIT \
    &macro_tap &rgb_ug OFF

/* ----MACRO HELPERS (Templates for building new macros) ---- */
#define MOMENTARY_RGB_MACRO(node_name, node_label, layer, active_color, release_color) \
        ZMK_MACRO(node_name, \
            bindings = \
                <&macro_press>, \
                <&mo layer>, \
                <&macro_tap>, \
                <&rgb_ug active_color>, \
                <&macro_pause_for_release>, \
                <&macro_release>, \
                <&mo layer>, \
                <&macro_tap>, \
                <&rgb_ug release_color>; \
            label = node_label; \
        )

#define TO_RGB_MACRO(node_name, node_label, layer, color) \
        ZMK_MACRO(node_name, \
            bindings = \
                <&macro_tap>, \
                <&to layer>, \
                <&macro_tap>, \
                <&rgb_ug color>; \
            label = node_label; \
        )

#define TO_RGB_PRESS_MACRO(node_name, node_label, layer, color) \
        ZMK_MACRO(node_name, \
            bindings = \
                <&macro_tap>, \
                <&to layer>, \
                <&macro_press>, \
                <&rgb_ug color>; \
            label = node_label; \
        )   

/* ---- HOLD-TAP BEHAVIOR TEMPLATE ---- */
#define RGB_HOLD_TAP(node_name, node_label, macro_ref) \
        node_name: node_name { \
            compatible = "zmk,behavior-hold-tap"; \
            label = node_label; \
            bindings = <&macro_ref>, <&kp>; \
            #binding-cells = <2>; \
            tapping-term-ms = <180>; \
            flavor = "tap-preferred"; \
        };

/* ---- STEP 5: (optional) COMBO HELPER ---- */
#define COMBO(name, bind, p1, p2, ...) \
    name { bindings = <bind>; key-positions = <p1 p2>; layers = <__VA_ARGS__>; timeout-ms = <50>; }
 /{
    /* ---- STEP 2+3: MACROS (build macros for all needed behaviors/layers) ---- */
    macros {
        /* Toggled and momentary macros for RGB layers */
        TO_RGB_MACRO(game_led, "GameLayer LED Macro", LAYER_GAME, RGB_GAME)
        MOMENTARY_RGB_MACRO(xtra2_led, "xtra2Layer Momentary LED Macro", LAYER_XTR2, RGB_XTRA2, RGB_ABC)
        MOMENTARY_RGB_MACRO(kpad_led, "KeyPadLayer Momentary LED Macro", LAYER_KPAD, RGB_KPAD, RGB_ABC)
        MOMENTARY_RGB_MACRO(xtra_led, "ExtraLayer Momentary LED Macro", LAYER_XTRA, RGB_XTRA, RGB_ABC)
        MOMENTARY_RGB_MACRO(nmrw_led, "NumberRowLayer Momentary LED Macro", LAYER_NMRW, RGB_NMRW, RGB_ABC)
        MOMENTARY_RGB_MACRO(gfun_led, "GameLayer Sublayer Momentary LED Macro", LAYER_GFUN, RGB_GFUN, RGB_GAME)
        MOMENTARY_RGB_MACRO(t2_s1_led, "ToggleLayer2 SubLayer1 Momentary LED Macro", LAYER_TGLLR_2_SUBLR_1, RGB_TGLLR_2_SUBLR_1, RGB_TGLLR_2)
        MOMENTARY_RGB_MACRO(t1_s1_led, "ToggleLayer1 Sublayer1 Momentary LED Macro", LAYER_TGLLR_1_SUBLR_1, RGB_TGLLR_1_SUBLR_1, RGB_TGLLR_1)
        MOMENTARY_RGB_MACRO(g2_s1_led, "GameLayer2 SubLayer1 Momentary LED Macro", LAYER_GAME2_SUBLR1, RGB_GAME2_SUBLR_1, RGB_GAME2) 

        TO_RGB_MACRO(default_led, "Base Layer LED", LAYER_ABC, RGB_ABC)
        TO_RGB_MACRO(t1_led, "ToggleLayer1 LED", LAYER_TGLLR_1, RGB_TGLLR_1)
        TO_RGB_MACRO(to_t2_led, "ToggleLayer2 LED", LAYER_TGLLR_2, RGB_TGLLR_2)
        TO_RGB_MACRO(g2_led, "Game2 LED Macro", LAYER_GAME2, RGB_GAME2)

        //Toggle Layers/Gateways
        TO_RGB_PRESS_MACRO(toglayers_leds, "ToggleLayer LED", LAYER_TGL, RGB_TGL)
        TO_RGB_PRESS_MACRO(gtgl_led, "gametoggle LED Macro", LAYER_GAMETGL, RGB_GAMETGL)
    };

    /* ---- OPTIONAL: BLINK/STATUS MACROS ---- */
    blnk: blnk {
        compatible = "zmk,behavior-macro-one-param";
        label = "BLINK (key param)";
        #binding-cells = <1>;
        wait-ms = <0>;
        tap-ms  = <0>;
        bindings = <
            &macro_param_1to1
            &macro_tap &kp MACRO_PLACEHOLDER
            BLINK_SEQ(BLINK_ON, BLINK_OFF, 100)
        >;
    };
    ZMK_MACRO(caps_blink,
        label = "CAPS TOGGLE + BLINK";
        bindings = <&macro_tap &kp CAPS BLINK_SEQ(C_BLINK_ON, C_BLINK_OFF, 80)>;
    )
    ZMK_MACRO(num_blink,
        label = "NUM TOGGLE + BLINK";
        bindings = <&macro_tap &kp KP_NUMLOCK BLINK_SEQ(N_BLINK_ON, N_BLINK_OFF, 80)>;
    )

    /* ---- STEP 4: BEHAVIORS - HOLD-TAP ---- */
/* Build behaviors for momentary layers here using the macros you built above */
    behaviors {
        RGB_HOLD_TAP(hold_tap_nmrw, "HOLD_TAP_NMRW", nmrw_led)
        RGB_HOLD_TAP(hold_tap_xtra2, "HOLD_TAP_XTRA2", xtra2_led)
        RGB_HOLD_TAP(hold_tap_kpad, "HOLD_TAP_KPAD", kpad_led)
        RGB_HOLD_TAP(hold_tap_xtra, "HOLD_TAP_XTRA", xtra_led)
        RGB_HOLD_TAP(hold_tap_gfun, "HOLD_TAP_GFUN", gfun_led)
        RGB_HOLD_TAP(hold_tap_t2_s1, "HOLD_TAP_layer2_sublayer1", t2_s1_led)
        RGB_HOLD_TAP(hold_tap_g2_s1, "HOLD_TAP_GAME2_SUBLAYER1", g2_s1_led)
        RGB_HOLD_TAP(hold_tap_t1_s1, "HOLD_TAP_TOGGLELAYER2_SUBLAYER1", t1_s1_led)

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
            quick-tap-ms = <180>;
            global-quick-tap;
        };
        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <600>;
            global-quick-tap;
            quick-tap-ms = <400>;
        };
    };

    /* ---- (OPTIONAL) STEP 5: COMBOS ---- */
    combos {
        compatible = "zmk,combos";
        COMBO(left_bkt,   &kp LEFT_BRACKET,   4,  3,  LAYER_ABC);
        COMBO(right_bkt,  &kp RBKT,           7,  8,  LAYER_ABC);
        COMBO(left_par,   &kp LEFT_PARENTHESIS,15,16, LAYER_ABC);
        COMBO(right_par,  &kp RIGHT_PARENTHESIS,19,20, LAYER_ABC);
        COMBO(left_brace, &kp LEFT_BRACE,     27,28, LAYER_ABC);
        COMBO(right_brace,&kp RIGHT_BRACE,    32,31, LAYER_ABC);
        COMBO(bac,        &kp BACKSLASH,      5, 6, LAYER_ABC);
        COMBO(pipe,       &kp PIPE,           17,18, LAYER_ABC);

        COMBO(gameLayer,  &game_led,           0,11, LAYER_ABC LAYER_TGL LAYER_GAME2);
        COMBO(gameLayer_2_BaseLayer, &default_led, 0,11, LAYER_GAME);
        COMBO(toggleLayer, &toglayers_leds,  38,39, LAYER_ABC LAYER_TGLLR_1 LAYER_TGLLR_2);
        COMBO(toggleLayer_2_defaultLayer, &default_led, 39,38, LAYER_TGL);
        COMBO(game_toggle, &gtgl_led,        38,39, LAYER_GAME LAYER_GAME2);
        COMBO(game_toggle_2_game, &game_led, 38,39, LAYER_GAMETGL);
    };

    /* Tap dance */
    td_numcaps: td_numcapsBLINK {
        compatible = "zmk,behavior-tap-dance";
        #binding-cells = <0>;
        tapping-term-ms = <300>;
        bindings = <&kp LSFT>, <&caps_blink>, <&num_blink>;
    };
};