/*
 * ANY new layers go here, each with an assigned color. The helpers below let you
 * avoid the “standard” ZMK formatting and add RGB logic with a few definitions.
 *
 * Order of operations (do these in order):
 *   1) #define the layer ID (number used in your keymap).
 *   1a) #define the layer color with RGB_COLOR_HSB(H, S, B).
 *   2) Build the MACRO:
 *        - Momentary layer RGB:   MOMENTARY_RGB_MACRO(node, "label", LAYER_, NEWCOLOR, DEFAULT_COLOR)
 *          (Press -> NEWCOLOR on that layer; Release -> DEFAULT_COLOR back on the previous layer)
 *        - Toggled layer RGB:     TO_RGB_MACRO(node, "label", LAYER_, NEWCOLOR)
 *          (Tap to switch layers and set NEWCOLOR)
 *        - Toggle-menu RGB:       TO_RGB_PRESS_MACRO(node, "label", LAYER_, NEWCOLOR)
 *          (Press to switch; used only by the two menu layers—rarely needed)
 *   3) For momentary layers, add the HOLD-TAP behavior:
 *        RGB_HOLD_TAP(node, "label", macro_ref_from_step_2)
 *        (Tap = normal key you bind later; Hold = runs the RGB macro so the layer
 *         stays active only while held and shows its NEWCOLOR)
 *   4) Map the macro/behavior into your keymap or combos.
 *
 * Making a momentary layer (common case for “sub-layouts” like GAME2, T1, T2, or
 * momentary toggled layers like NMRW, KPAD, XTRA, XTRA2, GFUN, T2S1):
 *   - Define layer ID and color (steps 1, 1a)
 *   - MOMENTARY_RGB_MACRO(...) for that layer
 *   - RGB_HOLD_TAP(...) pointing to that macro
 *   - Bind the hold-tap in your base layer.
 *
 * Making a toggled layer:
 *   - Define layer ID and color
 *   - TO_RGB_MACRO(...) for that layer
 *   - Bind the macro to a key or combo; tap to switch and set the color
 *
 * Layer roles to keep in mind:
 *   BaseLayer   = stays on (e.g., ABC)
 *   ToggleLayer = only used to jump to other bases (e.g., the menu layers with PRESS macros)
 *   Momentary   = active while held (focus for sub-layouts and quick access)
 */

// ---- LAYER DEFINITIONS ----
#define LAYER_ABC      0
#define LAYER_NMRW     1
#define LAYER_KPAD     2
#define LAYER_XTRA     3
#define LAYER_XTR2     4
#define LAYER_GAME     5
#define LAYER_GFUN     6
#define LAYER_GAMETGL  7
#define LAYER_GAME2    8
#define LAYER_TGL      9
#define LAYER_T1      10
#define LAYER_T2      11
#define LAYER_T2S1    12

// ---- COLOR DEFINITIONS ----
#define RGB_ABC      RGB_COLOR_HSB(19,100,17)   /* BASE */
#define RGB_NMRW     RGB_COLOR_HSB(183,45,18)   /* SUB-LAYOUT */
#define RGB_KPAD     RGB_COLOR_HSB(230,87,26)   /* SUB-LAYOUT */
#define RGB_XTRA     RGB_COLOR_HSB(273,67,23)   /* SUB-LAYOUT */
#define RGB_XTR2     RGB_COLOR_HSB(116,67,26)   /* SUB-LAYOUT */
#define RGB_GAME     RGB_COLOR_HSB(0,100,25)    /* SUB-BASE */
#define RGB_GFUN     RGB_COLOR_HSB(116,67,50)   /* SUB-LAYOUT */
#define RGB_GAMETGL  RGB_COLOR_HSB(200,100,60)  /* TOGGLE-LAYER */
#define RGB_GAME2    RGB_COLOR_HSB(73,67,15)    /* SUB-BASE */
#define RGB_TGL      RGB_COLOR_HSB(251,67,50)   /* TOGGLE-LAYER */
#define RGB_T1       RGB_COLOR_HSB(40,100,12)   /* SUB-BASE */
#define RGB_T2       RGB_COLOR_HSB(85,100,15)   /* SUB-BASE */
#define RGB_T2S1     RGB_COLOR_HSB(82,100,50)   /* SUB-LAYOUT */
#define BLINK_ON   RGB_COLOR_HSB(39,100,75)
#define BLINK_OFF  RGB_COLOR_HSB(273,67,23)
#define BLINK_SEQ(ON, OFF, WAIT)                                     \
  &macro_tap &rgb_ug ON                                              \
  &macro_wait_time WAIT                                              \
  &macro_tap &rgb_ug RGB_TOG                                         \
  &macro_wait_time WAIT                                              \
  &macro_tap &rgb_ug RGB_TOG                                         \
  &macro_wait_time WAIT                                              \
  &macro_tap &rgb_ug OFF

// ---- MACRO DEFINITIONS ----
/ {
  macros {
    default_led: default_led {
      compatible = "zmk,behavior-macro";
      label = "Base";
      bindings = <&macro_tap &to LAYER_ABC &macro_tap &rgb_ug RGB_ABC>;
    };
    game_led: game_led {
      compatible = "zmk,behavior-macro";
      label = "Game";
      bindings = <&macro_tap &to LAYER_GAME &macro_tap &rgb_ug RGB_GAME>;
    };
    g2_led: g2_led {
      compatible = "zmk,behavior-macro";
      label = "Game2";
      bindings = <&macro_tap &to LAYER_GAME2 &macro_tap &rgb_ug RGB_GAME2>;
    };
    t1_led: t1_led {
      compatible = "zmk,behavior-macro";
      label = "T1";
      bindings = <&macro_tap &to LAYER_T1 &macro_tap &rgb_ug RGB_T1>;
    };
    to_t2_led: to_t2_led {
      compatible = "zmk,behavior-macro";
      label = "T2";
      bindings = <&macro_tap &to LAYER_T2 &macro_tap &rgb_ug RGB_T2>;
    };
    toglayers_leds: toglayers_leds {
      compatible = "zmk,behavior-macro";
      label = "TGL";
      bindings = <&macro_tap &to LAYER_TGL &macro_press &rgb_ug RGB_TGL>;
    };
    gtgl_led: gtgl_led {
      compatible = "zmk,behavior-macro";
      label = "GTGL";
      bindings = <&macro_tap &to LAYER_GAMETGL &macro_press &rgb_ug RGB_GAMETGL>;
    };
    xtra2_led: xtra2_led {
      compatible = "zmk,behavior-macro";
      label = "X2 MO";
      bindings = <&macro_press &mo LAYER_XTR2 &macro_tap &rgb_ug RGB_XTR2 &macro_pause_for_release &macro_release &mo LAYER_XTR2 &macro_tap &rgb_ug RGB_ABC>;
    };
    kpad_led: kpad_led {
      compatible = "zmk,behavior-macro";
      label = "KP MO";
      bindings = <&macro_press &mo LAYER_KPAD &macro_tap &rgb_ug RGB_KPAD &macro_pause_for_release &macro_release &mo LAYER_KPAD &macro_tap &rgb_ug RGB_ABC>;
    };
    xtra_led: xtra_led {
      compatible = "zmk,behavior-macro";
      label = "X MO";
      bindings = <&macro_press &mo LAYER_XTRA &macro_tap &rgb_ug RGB_XTRA &macro_pause_for_release &macro_release &mo LAYER_XTRA &macro_tap &rgb_ug RGB_ABC>;
    };
    nmrw_led: nmrw_led {
      compatible = "zmk,behavior-macro";
      label = "NR MO";
      bindings = <&macro_press &mo LAYER_NMRW &macro_tap &rgb_ug RGB_NMRW &macro_pause_for_release &macro_release &mo LAYER_NMRW &macro_tap &rgb_ug RGB_ABC>;
    };
    gfun_led: gfun_led {
      compatible = "zmk,behavior-macro";
      label = "GF MO";
      bindings = <&macro_press &mo LAYER_GFUN &macro_tap &rgb_ug RGB_GFUN &macro_pause_for_release &macro_release &mo LAYER_GFUN &macro_tap &rgb_ug RGB_GAME>;
    };
    t2_s1_led: t2_s1_led {
      compatible = "zmk,behavior-macro";
      label = "T2S1MO";
      bindings = <&macro_press &mo LAYER_T2S1 &macro_tap &rgb_ug RGB_T2S1 &macro_pause_for_release &macro_release &mo LAYER_T2S1 &macro_tap &rgb_ug RGB_T2>;
    };
  };

  combos {
    compatible = "zmk,combos";
    COMBO(left_bkt,   &kp LEFT_BRACKET,   4,  3,  LAYER_ABC);
    COMBO(right_bkt,  &kp RBKT,           7,  8,  LAYER_ABC);
    COMBO(left_par,   &kp LEFT_PARENTHESIS,15,16, LAYER_ABC);
    COMBO(right_par,  &kp RIGHT_PARENTHESIS,19,20, LAYER_ABC);
    COMBO(left_brace, &kp LEFT_BRACE,     27,28, LAYER_ABC);
    COMBO(right_brace,&kp RIGHT_BRACE,    32,31, LAYER_ABC);
    COMBO(bac,        &kp BACKSLASH,      5,  6, LAYER_ABC);
    COMBO(pipe,       &kp PIPE,           17,18, LAYER_ABC);
    COMBO(gameLayer,  &game_led,           0,11, LAYER_ABC LAYER_TGL LAYER_GAME2);
    COMBO(gameLayer_2_BaseLayer, &default_led, 0,11, LAYER_GAME);
    COMBO(toggleLayer, &toglayers_leds,  38,39, LAYER_ABC LAYER_T1 LAYER_T2);
    COMBO(toggleLayer_2_defaultLayer, &default_led, 39,38, LAYER_TGL);
    COMBO(game_toggle, &gtgl_led,        38,39, LAYER_GAME LAYER_GAME2);
    COMBO(game_toggle_2_game, &game_led, 38,39, LAYER_GAMETGL);
  };

  td_numcaps: td_numcapsBLINK {
    compatible = "zmk,behavior-tap-dance";
    #binding-cells = <0>;
    tapping-term-ms = <300>;
    bindings = <&kp LSFT>, <&caps_blink>, <&num_blink>;
  };

  blnk: blnk {
    compatible = "zmk,behavior-macro-one-param";
    label = "BLINK";
    #binding-cells = <1>;
    wait-ms = <0>;
    tap-ms  = <0>;
    bindings = < &macro_param_1to1 &macro_tap &kp MACRO_PLACEHOLDER BLINK_SEQ(BLINK_ON, BLINK_OFF, 100) >;
  };

  caps_blink: caps_blink {
    compatible = "zmk,behavior-macro";
    label = "CAPS BLINK";
    #binding-cells = <0>;
    bindings = < &macro_tap &kp CAPS BLINK_SEQ(RGB_COLOR_HSB(200,100,60), RGB_ABC, 80) >;
  };

  num_blink: num_blink {
    compatible = "zmk,behavior-macro";
    label = "NUM BLINK";
    #binding-cells = <0>;
    bindings = < &macro_tap &kp KP_NUMLOCK BLINK_SEQ(RGB_COLOR_HSB(0,100,60), RGB_ABC, 80) >;
  };

  behaviors {
    hm: homerow_mods {
      compatible = "zmk,behavior-hold-tap";
      label = "HM";
      #binding-cells = <2>;
      tapping-term-ms = <200>;
      quick_tap_ms = <0>;
      flavor = "tap-preferred";
      bindings = <&kp>, <&kp>;
      quick-tap-ms = <180>;
      global-quick-tap;
    };

    ltq: ltq {
      compatible = "zmk,behavior-hold-tap";
      label = "LTQ";
      bindings = <&mo>, <&kp>;
      #binding-cells = <2>;
      tapping-term-ms = <600>;
      global-quick-tap;
      quick-tap-ms = <400>;
    };

    // Momentary layer hold-taps
    RGB_HOLD_TAP(hold_tap_nmrw, "HT NMRW", nmrw_led)
    RGB_HOLD_TAP(hold_tap_xtra2,"HT X2",   xtra2_led)
    RGB_HOLD_TAP(hold_tap_kpad, "HT KP",   kpad_led)
    RGB_HOLD_TAP(hold_tap_xtra, "HT X",    xtra_led)
    RGB_HOLD_TAP(hold_tap_gfun, "HT GF",   gfun_led)
    RGB_HOLD_TAP(hold_tap_t2_s1,"HT T2S1", t2_s1_led)
  };
};